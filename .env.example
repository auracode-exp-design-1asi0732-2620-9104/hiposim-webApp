# Copy to .env.development.local to override the defaults in .env.development (Vite gives .env.development priority over .env.local).
# URL of the HipoSim API (the launch profile port of the backend).
VITE_API_URL=http://localhost:5000
# true = sample data in the browser (no API needed). false = real API calls.
VITE_USE_MOCK=false
